<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Editorial theme: ivory paper, deep pine, terracotta, with Lora for headings.

      The parent is DayNight, so switching the device to dark mode swaps in
      values-night/colors.xml with no extra work. Anything colour-related belongs in colors.xml
      rather than here, so both modes stay in sync.
    -->
    <style name="Base.Theme.FinalProject" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/background</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:navigationBarColor">@color/card_background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Journify.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Journify.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Journify.LargeComponent</item>

        <item name="materialButtonStyle">@style/Widget.Journify.Button</item>
        <item name="textInputStyle">@style/Widget.Journify.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.Journify.Card</item>
        <item name="chipStyle">@style/Widget.Journify.Chip</item>

        <!-- Headline slots are what make the serif show up on Material's own widgets. -->
        <item name="textAppearanceHeadline5">@style/TextAppearance.Journify.Display</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Journify.Title</item>
    </style>

    <style name="Theme.FinalProject" parent="Base.Theme.FinalProject" />

    <!--
      Type scale. Display and Title carry Lora; everything smaller stays on the system sans,
      where a serif would only cost legibility. Apply with android:textAppearance.
    -->
    <style name="TextAppearance.Journify.Display" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/journify_display</item>
        <item name="android:fontFamily">@font/journify_display</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Journify.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/journify_display</item>
        <item name="android:fontFamily">@font/journify_display</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Journify.Serif" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/journify_display</item>
        <item name="android:fontFamily">@font/journify_display</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Small all-caps label above a section, the magazine kicker. -->
    <style name="TextAppearance.Journify.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Journify.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="ShapeAppearance.Journify.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.Journify.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Journify.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <!--
      One button family, four roles. Before this the layouts mixed raw Material styles at six
      different heights and three corner radii; every button now inherits the same height,
      radius and label treatment so a screen reads as one set of controls.

      Filled  - the single main action on a screen.
      Tonal   - supporting actions that still deserve a surface (map, export).
      Outline - secondary actions next to a filled one.
      Text    - low emphasis, inline.
      Danger  - destructive, tonal rather than loud red.
    -->
    <style name="Widget.Journify.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/primary_soft</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.Journify.Button.Tonal" parent="Widget.Journify.Button">
        <item name="backgroundTint">@color/primary_soft</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="rippleColor">@color/primary</item>
    </style>

    <style name="Widget.Journify.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/input_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/primary</item>
        <item name="rippleColor">@color/primary_soft</item>
    </style>

    <style name="Widget.Journify.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/primary</item>
        <item name="rippleColor">@color/primary_soft</item>
    </style>

    <style name="Widget.Journify.Button.Danger" parent="Widget.Journify.Button.Tonal">
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/alert_red_soft</item>
        <item name="android:textColor">@color/alert_red</item>
        <item name="iconTint">@color/alert_red</item>
        <item name="rippleColor">@color/alert_red</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!--
      Cards were all elevation 0, which is most of why the app read as flat. A small, consistent
      lift plus a hairline stroke gives depth without the heavy Material drop shadow.
    -->
    <style name="Widget.Journify.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Journify.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>

    <style name="Widget.Journify.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_border</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <!--
      Toolbar segment. Separate from Button.Text because that style carries 14dp of horizontal
      padding, which inside a 36dp segment leaves no room for the label and ellipsises "VN".
    -->
    <style name="Widget.Journify.Segment" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/language_segment_text</item>
        <item name="backgroundTint">@color/language_segment_background</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">15dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/language_segment_text</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!--
      Back button. Previously each screen rolled its own: 48dp or 25sp, primary or text_primary,
      and place detail even had a square card background. One circular tonal target now matches
      the tonal buttons used elsewhere.
    -->
    <style name="Widget.Journify.BackButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:text">‹</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:contentDescription">@string/back</item>
    </style>
</resources>
