<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        android:elevation="0dp"
        app:titleTextColor="@color/primary"
        app:title="Journify">

        <!--
          Both pills live in one end-gravity row. Two separate end-gravity children would
          overlap and push the toolbar title off screen.
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <!--
          Appearance switch. Deliberately the same pill, icon and two-segment toggle as the
          language control beside it so the pair reads as one row of settings.
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_language_switch"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@string/dark_mode"
                android:src="@drawable/ic_theme_20"
                app:tint="@color/primary" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/themeToggleGroup"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeLightButton"
                    style="@style/Widget.Journify.Segment"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/theme_light"
                    app:icon="@drawable/ic_sun_16" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeDarkButton"
                    style="@style/Widget.Journify.Segment"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/theme_dark"
                    app:icon="@drawable/ic_moon_16" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_language_switch"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@string/language_switch_label"
                android:src="@drawable/ic_language_20"
                app:tint="@color/primary" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/languageToggleGroup"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/languageVietnameseButton"
                    style="@style/Widget.Journify.Segment"
                    android:layout_width="36dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/use_vietnamese"
                    android:text="VN" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/languageEnglishButton"
                    style="@style/Widget.Journify.Segment"
                    android:layout_width="36dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/use_english"
                    android:text="EN" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tabPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:itemActiveIndicatorStyle="@style/Widget.MaterialComponents.BottomNavigationView.Colored"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
