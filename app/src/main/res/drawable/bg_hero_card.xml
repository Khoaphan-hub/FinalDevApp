<?xml version="1.0" encoding="utf-8"?>
<!-- Pine gradient behind the home call-to-action, so the block reads as depth rather than a slab. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/primary_container"
        android:endColor="@color/primary_dark"
        android:type="linear" />
    <corners android:radius="26dp" />
</shape>
