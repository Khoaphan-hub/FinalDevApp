<?xml version="1.0" encoding="utf-8"?>
<!--
  Laid over a photograph so white text sitting at the bottom stays readable whatever the image
  underneath happens to be. Transparent at the top, dark at the bottom.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/scrim_strong"
        android:centerColor="#99000000"
        android:endColor="@android:color/transparent"
        android:type="linear" />
</shape>
